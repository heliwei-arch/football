{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 generate_static.py",
  "outputDirectory": "public",
  "installCommand": "echo '--- No npm/python dependencies required (stdlib only) ---'",
  "framework": null,
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "s-maxage=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Cache-Control", "value": "s-maxage=0, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/data/(.*).json",
      "headers": [
        { "key": "Cache-Control", "value": "s-maxage=3600, stale-while-revalidate=43200" },
        { "key": "Content-Type", "value": "application/json; charset=utf-8" }
      ]
    }
  ],
  "redirects": [],
  "rewrites": [
    { "source": "/",                      "destination": "/index.html" },
    { "source": "/men",                   "destination": "/index.html" },
    { "source": "/men.html",              "destination": "/index.html" },
    { "source": "/women",                 "destination": "/women.html" },
    { "source": "/api/health",            "destination": "/data/health.json" },
    { "source": "/api/dashboard",         "destination": "/data/dashboard.json" },
    { "source": "/api/dashboard-women",   "destination": "/data/dashboard-women.json" },
    { "source": "/api/dashboard/:region", "destination": "/data/dashboard-:region.json" },
    { "source": "/api/push/latest",       "destination": "/data/push-latest.json" },
    { "source": "/api/push/history",      "destination": "/data/push-history.json" }
  ],
  "functions": {
    "api/refresh.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/refresh",
      "schedule": "0 1 * * *"
    }
  ]
}

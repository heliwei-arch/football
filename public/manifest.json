{
  "id": "ft-zazao-heliwei-arch-github-io",
  "name": "FT早知道 · 足球日报（懂球帝真实数据）",
  "short_name": "FT早知道",
  "description": "每日9点懂球帝真实数据男足/女足日报：昨日赛况T-1复盘 + 今日预告T0焦点，28天可回溯，球队详情+战术阵型，支持Hash路由（#men #women #team=xxx #date=YYYY-MM-DD）。字节内网可访问（GitHub Pages白名单）。",
  "lang": "zh-CN",
  "dir": "ltr",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "window", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#0f172a",
  "theme_color": "#1e40af",
  "categories": ["sports", "news", "lifestyle"],
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "男足日报",
      "short_name": "男足",
      "description": "直接打开男足版（默认深色）",
      "url": "./index.html#men",
      "icons": [
        { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
        { "src": "./icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
      ]
    },
    {
      "name": "女足日报",
      "short_name": "女足",
      "description": "直接打开女足版（奶白粉浅色）",
      "url": "./index.html#women",
      "icons": [
        { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
        { "src": "./icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
      ]
    },
    {
      "name": "⚡ 立即更新",
      "short_name": "更新",
      "description": "强制调用懂球帝API重抓今日数据（仅本地server.py可用）",
      "url": "./index.html",
      "icons": [
        { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
        { "src": "./icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
      ]
    }
  ],
  "protocol_handlers": [
    { "protocol": "web+ftzazao", "url": "./index.html?uri=%s" }
  ],
  "related_applications": [
    { "platform": "webapp", "url": "https://heliwei-arch.github.io/football/manifest.json", "id": "ft-zazao-heliwei-arch-github-io" },
    { "platform": "play", "url": "https://play.google.com/store/apps/details?id=com.bytedance.ft.zazao", "id": "com.bytedance.ft.zazao" }
  ],
  "prefer_related_applications": false,
  "edge_side_panel": { "preferred_width": 480 },
  "launch_handler": { "client_mode": ["navigate-existing", "auto"] }
}
